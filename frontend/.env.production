# Both hosts are one Vercel deployment. On the live host the app talks to the shared backend through the same-origin
# /api, which vercel.json proxies to Convex; the demo host keeps the in-browser mock and links to the live version.
VITE_LIVE_HOSTS=summarevent-live.vercel.app
VITE_LIVE_URL=https://summarevent-live.vercel.app
